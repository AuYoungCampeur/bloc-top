#!/usr/bin/env sh

# Test the committed snapshot; serialize heavy checks to limit CPU/memory pressure.
set -eu

release_stash=''
release_log_dir=$(mktemp -d)

cleanup() {
  release_status=$?
  trap - EXIT
  if [ -n "$release_stash" ]; then
    if git stash apply --index -q "$release_stash"; then
      # Another process may have created a stash. Never drop that process's data.
      if [ "$(git rev-parse stash@{0})" = "$release_stash" ]; then
        git stash drop -q
      fi
    else
      printf '%s\n' "Could not restore working changes automatically; saved stash: $release_stash" >&2
      release_status=1
    fi
  fi
  rm -rf "$release_log_dir"
  exit "$release_status"
}
trap cleanup EXIT

if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  git stash push --include-untracked -q -m 'pre-push-checks'
  release_stash=$(git rev-parse stash@{0})
fi

run_check() {
  printf 'Checking %s...\n' "$1"
  if pnpm run "$1" > "$release_log_dir/$1.log" 2>&1; then
    printf '%s passed\n' "$1"
  else
    cat "$release_log_dir/$1.log"
    printf '%s failed; push aborted.\n' "$1" >&2
    return 1
  fi
}

run_check typecheck
run_check test:run
run_check test:ct
printf '%s\n' 'All pre-push checks passed.'
