# PWA 开发配置：复制为 apps/pwa/.env.local，勿提交真实凭据。
# 认证仍有硬编码生产 Cookie 域限制，见 docs/DEVELOPMENT.md。
MONGODB_URI=
MONGODB_DB_NAME=luoyuan-topo-dev

# 与 Editor 使用相同的随机密钥（32 字符以上）
BETTER_AUTH_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

NEXT_PUBLIC_EDITOR_URL=http://localhost:3001
# 与 Editor 的值一致，用于接收缓存刷新通知
REVALIDATE_SECRET=

NEXT_PUBLIC_AMAP_KEY=

# PWA 仍保留图片管理 API；使用这些 API 才需要 R2 配置。
# 当前公共图片域名写在源码中，切换 bucket 时需核查域名映射。
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
