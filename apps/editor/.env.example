# 后台开发配置：复制为 apps/editor/.env.local，勿提交真实凭据。
# 登录由 PWA 提供。认证仍有生产 Cookie 域限制，见 docs/DEVELOPMENT.md。
MONGODB_URI=
MONGODB_DB_NAME=luoyuan-topo-dev

# 必须与 PWA 一致
BETTER_AUTH_SECRET=
REVALIDATE_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_PWA_URL=http://localhost:3000

# 图片上传、列表、改名、删除需要 R2。
# 当前公共图片域名写在源码中，切换 bucket 时需核查域名映射。
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
