{
  "name": "bloctop",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test:run --concurrency=1",
    "test:run": "turbo run test:run --concurrency=1",
    "test:ct": "turbo run test:ct",
    "typecheck": "turbo run typecheck"
  },
  "lint-staged": {
    "apps/editor/**/*.{ts,tsx,js,mjs}": "pnpm --dir apps/editor exec eslint",
    "apps/pwa/**/*.{ts,tsx,js,mjs}": "pnpm --dir apps/pwa exec eslint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@parcel/watcher"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "turbo": "^2"
  },
  "packageManager": "pnpm@10.29.3"
}
